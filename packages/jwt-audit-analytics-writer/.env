SERVICE_NAME="pagopa-interop-jwt-audit-analytics-writer"
LOG_LEVEL=info

AWS_REGION="eu-south-1"
SQS_NOTIFICATION_ENDPOINT="http://localhost:9324/000000000000/jwt-audit-analytics"

DB_HOST="localhost"
DB_NAME="interop-kpi"
DB_USERNAME="postgres"
DB_PASSWORD="postgres"
DB_PORT=55000
DB_USE_SSL="false"
DB_SCHEMA_NAME="jwt"
DB_MAX_CONNECTION_POOL=10
DB_CONNECTION_RETRIES=10
DB_CONNECTION_MIN_TIMEOUT=2000
DB_CONNECTION_MAX_TIMEOUT=3000

MERGE_TABLE_SUFFIX="_staging"
BATCH_SIZE=2500

S3_BUCKET=interop-jwt-audit-analytics-bucket
S3_CUSTOM_SERVER=true
S3_SERVER_HOST=http://localhost
S3_SERVER_PORT=9000

AWS_CONFIG_FILE=aws.config.local