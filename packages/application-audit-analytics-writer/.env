SERVICE_NAME="application-audit-analytics-writer"
LOG_LEVEL=info

KAFKA_CLIENT_ID="application-audit"
KAFKA_GROUP_ID="application-audit-group-local"
KAFKA_BROKERS="localhost:9092"
KAFKA_TOPIC="application-audit"
KAFKA_DISABLE_AWS_IAM_AUTH="true"
KAFKA_AVERAGE_MESSAGE_SIZE_IN_BYTES=1000
KAFKA_MAX_WAIT_BATCH_MILLIS=60000
KAFKA_TOPIC_STARTING_OFFSET="earliest"
KAFKA_MESSAGES_TO_READ_PER_BATCH=40000

DB_HOST="localhost"
DB_NAME="interop-kpi"
DB_USERNAME="postgres"
DB_PASSWORD="postgres"
DB_PORT=5432
DB_USE_SSL="false"
DB_SCHEMA_NAME="application"
DB_MAX_CONNECTION_POOL=10
DB_CONNECTION_RETRIES=10
DB_CONNECTION_MIN_TIMEOUT=2000
DB_CONNECTION_MAX_TIMEOUT=3000
DB_MESSAGES_TO_INSERT_PER_BATCH=500
DB_INGEST_MODE="INSERT"

MERGE_TABLE_SUFFIX="_staging"

REDSHIFT_COPY_IAM_ROLE_ARN="arn:aws:iam::000000000000:role/RedshiftCopy"
GZ_COMPRESSION_LEVEL=3

S3_CUSTOM_SERVER=true
S3_SERVER_HOST=http://localhost
S3_SERVER_PORT=9000
S3_COPY_BUCKET=interop-application-audit-analytics-copy-bucket
S3_DELETE_AFTER_COPY=true

AWS_CONFIG_FILE=aws.config.local
AWS_REGION="eu-south-1"
