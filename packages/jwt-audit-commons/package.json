{
  "name": "pagopa-interop-jwt-audit-commons",
  "private": true,
  "version": "1.0.0",
  "description": "PagoPA Interoperability JWT audit shared components",
  "main": "dist",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "lint:autofix": "eslint . --ext .ts,.tsx --fix",
    "format:check": "prettier --check src",
    "format:write": "prettier --write src",
    "start": "tsx --watch ./src/index.ts",
    "build": "tsc",
    "check": "tsc --project tsconfig.check.json"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "ndjson": "2.0.0",
    "pagopa-interop-kpi-commons": "workspace:*",
    "pagopa-interop-kpi-models": "workspace:*",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/ndjson": "2.0.4",
    "@types/node": "20.14.6",
    "eslint": "^8.12.0",
    "prettier": "^2.6.2",
    "typescript": "5.4.5"
  }
}
