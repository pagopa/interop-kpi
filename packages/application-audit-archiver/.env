SERVICE_NAME="application-audit-archiver"
S3_BUCKET_NAME="bucket-name"
LOG_LEVEL=info

KAFKA_CLIENT_ID=key
KAFKA_GROUP_ID=4
KAFKA_BROKERS="localhost:9092"
KAFKA_DISABLE_AWS_IAM_AUTH="true"
S3_BUCKET=audit-archiver
S3_CUSTOM_SERVER=true
S3_SERVER_HOST=http://localhost
S3_SERVER_PORT=9000
KAFKA_TOPIC=application-audit
AVERAGE_KAFKA_MESSAGE_SIZE_IN_BYTES=1000
MESSAGES_TO_READ_PER_BATCH=5
MAX_WAIT_KAFKA_BATCH_MILLIS=60000
TOPIC_STARTING_OFFSET="earliest"
AWS_CONFIG_FILE=aws.config.local
AWS_REGION="eu-south-1"
